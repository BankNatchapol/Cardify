{
  "name": "cardify",
  "version": "0.1.0",
  "description": "Automatic flashcard generator using Agentic AI",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "unset ELECTRON_RUN_AS_NODE; NODE_ENV=development concurrently \"vite\" \"electron .\"",
    "build": "vite build && electron-builder",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "refine:thai": "node scripts/refine-thai.js",
    "audio:elevenlabs": "node scripts/generate-elevenlabs-audio.js",
    "audio:tag": "node scripts/tag-audio.js",
    "tts:setup": "tools/omnivoice-lab/setup.sh",
    "tts:ui": "tools/omnivoice-lab/run-ui.sh",
    "tts:smoke": "cd tools/omnivoice-lab && . .venv/bin/activate && python smoke_test.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/genai": "^2.10.0",
    "fflate": "^0.8.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@upstash/context7-mcp": "^3.2.2",
    "@vitejs/plugin-react": "^4.3.1",
    "ccusage": "^20.0.14",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
