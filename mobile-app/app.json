{
  "expo": {
    "name": "Cardify Mobile",
    "slug": "cardify-mobile",
    "scheme": "cardify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardify.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
