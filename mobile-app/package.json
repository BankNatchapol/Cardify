{
  "name": "cardify-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare-icon": "node scripts/prepare-icon.js",
    "start": "expo start",
    "ios": "npm run prepare-icon && expo run:ios",
    "prebuild:ios": "npm run prepare-icon && expo prebuild --platform ios",
    "run:ios": "npm run prepare-icon && expo run:ios",
    "refresh:ios": "npm run prepare-icon && expo run:ios --configuration Release --device --no-bundler",
    "test": "echo \"mobile UI tests are not configured yet; shared scheduler tests run from the repo root\"",
    "android": "expo run:android"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.14",
    "fflate": "^0.8.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "ts-fsrs": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
